NODE_ENV=development

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Prod (Neon): use the DIRECT host (*.neon.tech:5432), not the -pooler URL, and append ?sslmode=require
DATABASE_URL=postgres://dreamingcloud:dreamingcloud@localhost:5432/dreamingcloud
# Prod (Upstash): rediss://… (TLS). Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=1000
APP_URL=http://localhost:3000
# Set to true on Render (single service). Leave false locally — `pnpm dev` already starts a separate worker.
RUN_WORKER_IN_API=false
# Set to 1 to skip local Testcontainers-backed migration tests (Docker required otherwise)
SKIP_TESTCONTAINERS=

# Auth — production requires real PEM keys (RS256). Dev falls back to HMAC via COOKIE_SECRET.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SECRET=replace-with-a-long-random-cookie-secret
CSRF_SECRET=replace-with-a-long-random-csrf-secret

# OAuth (optional in local development — not wired in MVP)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/google/callback

# Email — leave RESEND_API_KEY empty to use console mailer (tokens redacted in logs)
EMAIL_FROM=DreamingCloud <noreply@localhost>
RESEND_API_KEY=

# Object storage (MinIO locally, R2/S3 in production)
# Prod (R2): S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com — bucket CORS must allow the Vercel origin (PUT, GET, HEAD)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=dreamingcloud-media
S3_ACCESS_KEY_ID=dreamingcloud
S3_SECRET_ACCESS_KEY=dreamingcloud
S3_FORCE_PATH_STYLE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel only (leave unset locally). NEXT_PUBLIC_API_URL becomes /api/v1 so cookies stay on the Vercel origin.
# API_ORIGIN=https://dreamingcloud-api.onrender.com
# API_INTERNAL_URL=https://dreamingcloud-api.onrender.com/api/v1
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_APP_URL=https://<projet>.vercel.app
